# Copy this file to ".env" for LOCAL testing only.
# On GitHub Actions, these same names are set as repo Secrets instead.

TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here
TELEGRAM_CHAT_ID=123456789

EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
EMAIL_TO=youraddress@gmail.com
EMAIL_MIN_SEVERITY=4

LOOKBACK_DAYS_FIRST_RUN=2
